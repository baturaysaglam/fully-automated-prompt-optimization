# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/

# Local-only operational artifacts (never checked in)
tenants/*/evals/
tenants/*/configs/**
!tenants/*/configs/.gitkeep
!tenants/hotpotqa/configs/local-chain-variant001.json
!tenants/hotpotqa/configs/remote-chain-variant001.json
!tenants/hotpotqa/configs/local-chain-variant001-train.json
!tenants/hotpotqa/configs/local-chain-variant001-test.json
!tenants/hotpotqa/configs/remote-chain-variant001-train.json
!tenants/hotpotqa/configs/remote-chain-variant001-test.json
tenants/*/reports/**
!tenants/*/reports/.gitkeep
reports/evals/tmp/

# Environment (contains API keys — never commit)
.envrc

# Internal-only docs and scrubbers (contain references to internal infrastructure)
SYNC_GUIDE.md
scripts/check_oss_safety.py

# Local eval results collected from K8s pods
local-results/

# BM25 index and corpus data (large, built on first run)
tenants/hotpotqa/data/
wiki.abstracts.2017.tar.gz

# Customer artifact payloads are GCS-backed, not git-tracked
tenants/*/source_artifacts/*
!tenants/*/source_artifacts/.gitkeep
tenants/*/datasets/*
!tenants/*/datasets/.gitkeep

# GEPA-baseline tenants: commit splits + fingerprint for byte-level lock
!tenants/aime/datasets/datasets/
!tenants/aime/datasets/datasets/*.jsonl
!tenants/aime/datasets/datasets/splits.meta.json
!tenants/hover/datasets/datasets/
!tenants/hover/datasets/datasets/*.jsonl
!tenants/hover/datasets/datasets/splits.meta.json
!tenants/livebench_math/datasets/datasets/
!tenants/livebench_math/datasets/datasets/*.jsonl
!tenants/livebench_math/datasets/datasets/splits.meta.json
!tenants/papillon/datasets/datasets/
!tenants/papillon/datasets/datasets/*.jsonl
!tenants/papillon/datasets/datasets/splits.meta.json
!tenants/ifbench/datasets/datasets/
!tenants/ifbench/datasets/datasets/*.jsonl
!tenants/ifbench/datasets/datasets/splits.meta.json

# Claude Code optimization run state (transient, not committed)
.claude/state/
